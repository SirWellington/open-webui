# Wellington custom environment template
#
# This is a template for the `.env` file at the REPO ROOT (one directory up from
# this folder). Copy the variables below into `<repo>/.env` and fill in real values.
#
#   cp wellington/.env.example  .env     (then edit .env with real secrets)
#
# The `.env` is gitignored. Do NOT commit real secrets.
#
# How each value is consumed:
#   - open-webui / docling-server / crawl4ai / mcpo services read them via
#     docker-compose `environment:` / `command:` substitution.
#   - SEARXNG_SECRET / SEARXNG_BRAVE_API_KEY are injected into the searxng
#     container, where wellington/searxng-config/settings.yml references them
#     via SearXNG's `!process "env:..."` indirection.
#   - CRAWL4AI_API_KEY is the Bearer token used by crawl4ai AND is the same
#     token that must appear in wellington/mcpo.json (Authorization header).
#
# NOTE: mcpo does NOT support env-var substitution in its JSON config, so the
# real CRAWL4AI_API_KEY value must be pasted into wellington/mcpo.json. Keep
# wellington/mcpo.json gitignored and use wellington/mcpo.json.example as the
# committed template.

# OpenWebUI core
WEBUI_SECRET_KEY=change-me-openwebui-jwt-secret

# MCP -> OpenAPI bridge (mcpo) REST auth
MCPO_API_KEY=change-me-mcpo-api-key

# Crawl4AI MCP server Bearer token (also required in wellington/mcpo.json)
CRAWL4AI_API_KEY=change-me-crawl4ai-bearer-token

# Docling document-conversion server API key
DOCLING_API_KEY=change-me-docling-api-key

# SearXNG (consumed by wellington/searxng-config/settings.yml)
SEARXNG_SECRET=change-me-searxng-server-secret
SEARXNG_BRAVE_API_KEY=change-me-brave-search-api-key
