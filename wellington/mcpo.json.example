{
  "mcpServers": {
    "searxng": {
      "type": "streamable-http",
      "url": "http://searxng-mcp:3000/mcp",
      "disabledTools": ["web_url_read", "searxng_search_suggestions", "searxng_instance_info"]
    },
    "crawl4ai": {
      "type": "sse",
      "url": "http://crawl4ai:11235/mcp/sse",
      "headers": { "Authorization": "Bearer CHANGE-ME-CRAWL4AI_API_KEY" },
      "disabledTools": ["execute_js", "screenshot", "pdf", "html", "ask"]
    }
  }
}
